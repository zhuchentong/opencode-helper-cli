{
  "name": "opencode-helper-cli",
  "description": "CLI tool for managing opencode plugins",
  "version": "0.0.0",
  "author": "zhuchentong",
  "bin": {
    "och": "./bin/run.js"
  },
  "bugs": "https://github.com/zhuchentong/opencode-helper-cli/issues",
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^18",
    "bumpp": "^11.1.0",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^11",
    "oclif": "^4",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "tsdown": "^0.22.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/zhuchentong/opencode-helper-cli",
  "keywords": [
    "oclif",
    "opencode",
    "cli",
    "plugin-manager"
  ],
  "license": "MIT",
  "main": "dist/index.mjs",
  "type": "module",
  "oclif": {
    "bin": "och",
    "dirname": "och",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " ",
    "topics": {
      "plugin": {
        "description": "Manage opencode plugins"
      }
    }
  },
  "repository": "zhuchentong/opencode-helper-cli",
  "scripts": {
    "build": "tsdown",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "pnpm run lint",
    "prepack": "oclif manifest",
    "release": "bumpp",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "types": "dist/index.d.mts"
}
